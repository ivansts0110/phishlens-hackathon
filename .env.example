# Optional. If set, PhishLens calls the Claude API to generate a plain-English
# risk summary alongside the heuristic score. Without it, the app still fully
# works using the heuristic engine only.
ANTHROPIC_API_KEY=

# Optional. Defaults to a fast/cheap model if unset.
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# Optional. Base URL of the Python enrichment service (see python-service/).
# Unset = enrichment is skipped, app works on heuristics alone.
PYTHON_SERVICE_URL=

# Optional. Slack/Discord/Mattermost incoming-webhook URL. If set, High/Critical
# scans post an alert. Unset = no alerts fired.
ALERT_WEBHOOK_URL=
